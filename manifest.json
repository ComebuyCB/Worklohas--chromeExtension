{
  "manifest_version": 3,
  "version": "1.706.1",
  "description": "快速打卡 | 複製內文 | 改變網站樣式 | 測試站帳密儲存與填入",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "static/img/icons/icon-16.png",
      "48": "static/img/icons/icon-48.png",
      "128": "static/img/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "static/img/icons/icon-b16.png",
    "48": "static/img/icons/icon-b48.png",
    "128": "static/img/icons/icon-b128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nueip.com/*",
        "https://*.591.com.tw/*",
        "https://projects.worklohas.com/*",
        "https://*.worklohas.com/*",
        "https://*.worklohas.dev/*"
      ],
      "js": [
        "static/plugins/jquery-3.6.4/jquery.min.js",
        "src/inject-config.js",
        "src/content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://*.nueip.com/*",
    "https://*.591.com.tw/*",
    "https://*.worklohas.com/*",
    "https://*.worklohas.dev/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/inject/**/*",
        "static/plugins/jquery-3.6.4/jquery.min.js"
      ],
      "matches": [
        "https://*.nueip.com/*",
        "https://*.591.com.tw/*",
        "https://projects.worklohas.com/*",
        "https://*.worklohas.com/*",
        "https://*.worklohas.dev/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite",
    "identity"
  ],
  "name": "Worklohas 擴充功能 (dev)",
  "oauth2": {
    "client_id": "804323187732-i12d3em757ot67fj9muc26micfi6e8ig.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "key": ""
}